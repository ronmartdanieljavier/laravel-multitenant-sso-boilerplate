              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reports\": [\n    {\n      \"type\": \"user_activity\",\n      \"format\": \"screen\",\n      \"delivery\": \"none\",\n      \"parameters\": { \"from\": \"2026-01-01\", \"to\": \"2026-06-20\" }\n    },\n    {\n      \"type\": \"app_access\",\n      \"format\": \"screen\",\n      \"delivery\": \"none\"\n    }\n  ]\n}",
