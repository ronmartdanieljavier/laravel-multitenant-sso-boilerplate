    {
      "name": "Reports",
      "description": "Async report generation endpoints. All requests require a Bearer token. The `report_id` collection variable is auto-saved by the 'Dispatch Single Report' test script.",
      "item": [
        {
          "name": "List Reports",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "reports"]
            },
            "description": "Returns a paginated list of reports belonging to the authenticated user, ordered by most recent."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
