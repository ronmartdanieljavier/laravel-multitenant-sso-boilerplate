  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints.\n\n**API auth** (`/api/login`, `/api/logout`) — stateless Sanctum token flow used by mobile clients and SPAs that manage their own token storage.\n\n**Web auth** (`/login`, `/logout`) — session-based flow for the browser frontend (Inertia.js). After login the server redirects: users with one app go directly to that app's dashboard; users with multiple apps are sent to `/apps` to choose. An idle session timeout (configurable via the `authentication_idle_time` system setting, default 30 min) automatically logs out inactive browser sessions. The web logout endpoint invalidates the session and redirects to `/login`.\n\nNote: web endpoints use Laravel session cookies and require a valid CSRF token (`X-XSRF-TOKEN` header or `_token` form field). They are documented here for reference — use the API endpoints for token-based integrations.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Authenticate with email and password. Returns a Bearer token, user info, and accessible apps with their tenants.\n\nDefault admin credentials are pre-filled via `admin_email` and `admin_password` collection variables (set from `ADMIN_EMAIL` / `ADMIN_PASSWORD` in your `.env`).\n\nThe test script automatically saves the returned token to the `token` collection variable."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "login"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"token\": \"1|abc123...\",\n  \"token_type\": \"Bearer\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Admin User\",\n    \"email\": \"admin@example.com\"\n  },\n  \"apps\": [\n    {\n      \"app_id\": 1,\n      \"name\": \"My App\",\n      \"slug\": \"my-app\",\n      \"url\": \"https://my-app.example.com\",\n      \"role\": \"admin\",\n      \"tenants\": [\n        {\n          \"tenant_id\": 1,\n          \"name\": \"Tenant A\",\n          \"slug\": \"tenant-a\",\n          \"role\": \"manager\",\n          \"is_default\": true\n        }\n      ]\n    }\n  ]\n}"
            },
            {
              "name": "401 Unauthorized",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"notauser@example.com\",\n  \"password\": \"wrongpassword\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "login"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"message\": \"Invalid credentials.\"\n}"
            }
          ]
        },
        {
          "name": "Logout (API)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "logout"]
            },
            "description": "Revokes the current Sanctum access token. Requires a valid Bearer token (inherited from collection auth). Use this for token-based (mobile / SPA) clients."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{base_url}}/api/logout",
                  "host": ["{{base_url}}"],
                  "path": ["api", "logout"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"message\": \"Logged out successfully.\"\n}"
            }
          ]
        },
        {
          "name": "Logout (Web)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "text/html" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}", "description": "Required CSRF token. Obtain from the XSRF-TOKEN cookie set by GET /login." }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            },
            "description": "Session-based web logout. Invalidates the Laravel session and regenerates the CSRF token, then redirects to `/login`.\n\nRequires an active browser session (session cookie) and a valid CSRF token in the `X-XSRF-TOKEN` header.\n\nThis is the endpoint the browser frontend calls — it is not a JSON API and does not use a Bearer token. The response is a `302` redirect to `/login`."
          },
          "response": [
            {
              "name": "302 Redirect to /login",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "text/html" },
                  { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/logout",
                  "host": ["{{base_url}}"],
                  "path": ["logout"]
                }
              },
              "status": "Found",
              "code": 302,
              "_postman_previewlanguage": "text",
              "header": [{ "key": "Location", "value": "http://localhost/login" }],
              "body": ""
            }
          ]
        },
        {
          "name": "Get Accessible Apps",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
