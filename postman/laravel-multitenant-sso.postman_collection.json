                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "[\n  {\n    \"app_id\": 1,\n    \"name\": \"My App\",\n    \"slug\": \"my-app\",\n    \"url\": \"https://my-app.example.com\",\n    \"role\": \"admin\",\n    \"tenants\": [\n      {\n        \"tenant_id\": 1,\n        \"name\": \"Tenant A\",\n        \"slug\": \"tenant-a\",\n        \"role\": \"manager\",\n        \"is_default\": true\n      }\n    ]\n  }\n]"
            }
          ]
        }
      ]
    },
    {
      "name": "Reports",
      "description": "Async report generation endpoints. All requests require a Bearer token. The `report_id` collection variable is auto-saved by the 'Dispatch Single Report' test script.",
      "item": [
