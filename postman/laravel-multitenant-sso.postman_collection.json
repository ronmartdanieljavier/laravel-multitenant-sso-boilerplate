        {
          "name": "Delete Report",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/reports/{{report_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "{{report_id}}"]
            },
            "description": "Deletes a report record and its associated file from storage. Owner-only — returns 403 for reports belonging to other users."
          },
          "response": [
            {
              "name": "204 No Content",
