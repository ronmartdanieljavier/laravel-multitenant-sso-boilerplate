    {
      "name": "Profile (Web)",
      "description": "User self-service profile endpoints. All three use the browser session (cookie + CSRF token) — they are not JSON API endpoints and do not use a Bearer token.\n\nRequires an active browser session (session cookie) and a valid CSRF token in the `X-XSRF-TOKEN` header. Each endpoint returns a `302` redirect back to `/profile` on success with a `flash.success` message.",
      "item": [
        {
          "name": "Update Display Name",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}", "description": "Required CSRF token. Obtain from the XSRF-TOKEN cookie set by any authenticated page load." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/profile/name",
              "host": ["{{base_url}}"],
              "path": ["profile", "name"]
            },
            "description": "Updates the authenticated user's display name. Validation: required, string, max 255 characters. Returns `302` back to `/profile` with a `flash.success` session value of `\"Display name updated.\"`."
          },
          "response": [
            {
              "name": "302 Redirect (success)",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Jane Doe\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/profile/name",
                  "host": ["{{base_url}}"],
                  "path": ["profile", "name"]
                }
              },
              "status": "Found",
              "code": 302,
              "_postman_previewlanguage": "text",
              "header": [{ "key": "Location", "value": "http://localhost/profile" }],
              "body": ""
            },
            {
              "name": "422 Validation Error",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/profile/name",
                  "host": ["{{base_url}}"],
                  "path": ["profile", "name"]
                }
