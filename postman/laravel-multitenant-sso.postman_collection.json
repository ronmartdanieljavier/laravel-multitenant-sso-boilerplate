                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reports\": [\n    { \"type\": \"user_activity\", \"format\": \"screen\", \"delivery\": \"none\" },\n    { \"type\": \"app_access\", \"format\": \"screen\", \"delivery\": \"none\" }\n  ]\n}"
                },
                "url": {
