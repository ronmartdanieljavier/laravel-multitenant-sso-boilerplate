        {
          "name": "Dispatch Single Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('report_id', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user_activity\",\n  \"format\": \"screen\",\n  \"delivery\": \"none\",\n  \"parameters\": {\n    \"from\": \"2026-01-01\",\n    \"to\": \"2026-06-20\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
