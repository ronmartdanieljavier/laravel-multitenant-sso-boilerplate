{
  "name": "laravel-multitenant-sso-boilerplate",
  "version": "1.0.0",
  "description": "A production-ready Laravel monorepo template for building multi-tenant SaaS platforms with Single Sign-On, granular per-user permissions, dynamic tenant database resolution across any server, and a scalable async reporting engine.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run test:unit && npm run test:e2e",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronmartdanieljavier/laravel-multitenant-sso-boilerplate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ronmartdanieljavier/laravel-multitenant-sso-boilerplate/issues"
  },
  "homepage": "https://github.com/ronmartdanieljavier/laravel-multitenant-sso-boilerplate#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "laravel-vite-plugin": "^3.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.4.0",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "driver.js": "^1.6.0",
    "framer-motion": "^12.42.0",
    "vue": "^3.5.38"
  }
}
