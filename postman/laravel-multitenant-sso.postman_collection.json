            }
          ]
        },
        {
          "name": "Upload Profile Picture",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}", "description": "Required CSRF token." }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "profile_picture",
                  "type": "file",
                  "description": "Image file (JPG, PNG, GIF). Max size: 2 MB."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/profile/picture",
              "host": ["{{base_url}}"],
              "path": ["profile", "picture"]
            },
            "description": "Uploads or replaces the authenticated user's profile picture. The file is stored on the `public` disk under `profile-pictures/` and the path is saved to `users.profile_picture`. Any previously uploaded picture is deleted. The public URL is exposed as `profile_picture_url` on the `auth.user` Inertia shared prop.\n\nValidation: required, must be an image (jpg/png/gif/bmp/svg/webp), max 2048 KB (2 MB).\n\nReturns `302` back to `/profile` with `flash.success = \"Profile picture updated.\"`."
          },
          "response": [
            {
              "name": "302 Redirect (success)",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [{ "key": "profile_picture", "type": "file" }]
                },
                "url": {
                  "raw": "{{base_url}}/profile/picture",
                  "host": ["{{base_url}}"],
                  "path": ["profile", "picture"]
                }
              },
              "status": "Found",
              "code": 302,
              "_postman_previewlanguage": "text",
              "header": [{ "key": "Location", "value": "http://localhost/profile" }],
              "body": ""
            },
            {
              "name": "422 Validation Error (not an image)",
