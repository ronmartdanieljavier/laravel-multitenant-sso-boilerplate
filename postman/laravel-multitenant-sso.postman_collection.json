                  { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [{ "key": "profile_picture", "type": "file", "description": "A non-image file, e.g. document.pdf" }]
                },
                "url": {
                  "raw": "{{base_url}}/profile/picture",
                  "host": ["{{base_url}}"],
                  "path": ["profile", "picture"]
                }
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"message\": \"The profile picture field must be an image.\",\n  \"errors\": {\n    \"profile_picture\": [\"The profile picture field must be an image.\"]\n  }\n}"
            }
          ]
