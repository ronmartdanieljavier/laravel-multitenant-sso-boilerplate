            }
          ]
        },
        {
          "name": "Dispatch Single Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('report_id', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user_activity\",\n  \"format\": \"screen\",\n  \"delivery\": \"none\",\n  \"parameters\": {\n    \"from\": \"2026-01-01\",\n    \"to\": \"2026-06-20\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "reports"]
            },
            "description": "Dispatches a single report job to the `reports` Redis queue. Status transitions: `pending → processing → success | failed`.\n\nValid `format` values: `screen`, `pdf`, `excel`.\nValid `delivery` values: `download`, `email`, `none`.\n\nThe test script auto-saves the returned report UUID to the `report_id` collection variable."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"type\": \"user_activity\",\n  \"format\": \"screen\",\n  \"delivery\": \"none\",\n  \"parameters\": {\n    \"from\": \"2026-01-01\",\n    \"to\": \"2026-06-20\"\n  }\n}"
